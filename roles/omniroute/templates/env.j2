# ─────────────────────────────────────────────────────────────────────────────
# OmniRoute Production Configuration — Managed by Ansible
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Storage & Database ───────────────────────────────────────────────────
DATA_DIR="{{ omniroute_data_dir }}"
DISABLE_SQLITE_AUTO_BACKUP="{{ 'true' if omniroute_disable_sqlite_auto_backup | bool else 'false' }}"
OMNIROUTE_SKIP_DB_HEALTHCHECK="{{ '1' if omniroute_skip_db_healthcheck | bool else '0' }}"

# ── 2. Network & Ports ──────────────────────────────────────────────────────
PORT="{{ omniroute_port }}"
NODE_ENV="{{ omniroute_node_env }}"
HOST="{{ omniroute_server_host }}"
OMNIROUTE_SERVER_HOST="{{ omniroute_server_host }}"

{% if omniroute_port_mode == 'split' %}
API_PORT="{{ omniroute_api_port }}"
API_HOST="{{ omniroute_api_host }}"
DASHBOARD_PORT="{{ omniroute_dashboard_port }}"
{% endif %}

{% if omniroute_base_path %}
OMNIROUTE_BASE_PATH="{{ omniroute_base_path }}"
NEXT_PUBLIC_OMNIROUTE_BASE_PATH="{{ omniroute_base_path }}"
{% endif %}

NEXT_PUBLIC_BASE_URL="{{ omniroute_public_base_url }}"
BASE_URL="{{ omniroute_public_base_url }}"
OMNIROUTE_PUBLIC_PROTOCOL="{{ omniroute_public_protocol }}"

{% if omniroute_trust_proxy %}
OMNIROUTE_TRUST_PROXY="{{ omniroute_trust_proxy }}"
{% endif %}

{% if omniroute_dashboard_allow_embed %}
DASHBOARD_ALLOW_EMBED="{{ omniroute_dashboard_allow_embed }}"
{% endif %}

# Live WebSocket Server
OMNIROUTE_ENABLE_LIVE_WS="{{ '1' if omniroute_live_ws_enabled | bool else '0' }}"
LIVE_WS_PORT="{{ omniroute_live_ws_port }}"
LIVE_WS_HOST="{{ omniroute_live_ws_host }}"
{% if omniroute_live_ws_allowed_origins %}
LIVE_WS_ALLOWED_ORIGINS="{{ omniroute_live_ws_allowed_origins | join(',') }}"
{% endif %}
{% if omniroute_live_ws_allowed_hosts %}
LIVE_WS_ALLOWED_HOSTS="{{ omniroute_live_ws_allowed_hosts | join(',') }}"
{% endif %}
{% if omniroute_live_ws_public_url %}
NEXT_PUBLIC_LIVE_WS_PUBLIC_URL="{{ omniroute_live_ws_public_url }}"
{% endif %}

# Peer Chaining
{% if omniroute_instance_id %}
OMNIROUTE_INSTANCE_ID="{{ omniroute_instance_id }}"
OMNIROUTE_PEER_URLS="{{ omniroute_peer_urls }}"
OMNIROUTE_PEER_MAX_HOPS="{{ omniroute_peer_max_hops }}"
{% endif %}

# ── 3. Security & Authentication ────────────────────────────────────────────
MACHINE_ID_SALT="{{ omniroute_machine_id_salt }}"
OMNIROUTE_CLI_SALT="{{ omniroute_cli_salt }}"
AUTH_COOKIE_SECURE="{{ 'true' if omniroute_auth_cookie_secure | bool else 'false' }}"
REQUIRE_API_KEY="{{ 'true' if omniroute_require_api_key | bool else 'false' }}"
ALLOW_API_KEY_REVEAL="{{ 'true' if omniroute_allow_api_key_reveal | bool else 'false' }}"
DEFAULT_RATE_LIMIT_PER_DAY="{{ omniroute_default_rate_limit_per_day }}"

{% if omniroute_no_log_api_key_ids %}
NO_LOG_API_KEY_IDS="{{ omniroute_no_log_api_key_ids | join(',') }}"
{% endif %}

{% if omniroute_cors_allow_all %}
CORS_ALLOW_ALL=true
{% elif omniroute_cors_allowed_origins %}
CORS_ALLOWED_ORIGINS="{{ omniroute_cors_allowed_origins | join(',') }}"
{% endif %}

# SSRF Guards
OMNIROUTE_ALLOW_PRIVATE_PROVIDER_URLS="{{ 'true' if omniroute_allow_private_provider_urls | bool else 'false' }}"
OMNIROUTE_ALLOW_LOCAL_PROVIDER_URLS="{{ 'true' if omniroute_allow_local_provider_urls | bool else 'false' }}"
OUTBOUND_SSRF_GUARD_ENABLED="{{ 'true' if omniroute_outbound_ssrf_guard_enabled | bool else 'false' }}"

# ── 4. Sanitization & Guardrails ────────────────────────────────────────────
INPUT_SANITIZER_ENABLED="{{ 'true' if omniroute_input_sanitizer_enabled | bool else 'false' }}"
INPUT_SANITIZER_MODE="{{ omniroute_input_sanitizer_mode }}"
INPUT_SANITIZER_BLOCK_THRESHOLD="{{ omniroute_input_sanitizer_block_threshold }}"
PII_REDACTION_ENABLED="{{ 'true' if omniroute_pii_redaction_enabled | bool else 'false' }}"
CREDENTIAL_REDACTION_ENABLED="{{ 'true' if omniroute_credential_redaction_enabled | bool else 'false' }}"
PII_WINDOW_SIZE="{{ omniroute_pii_window_size }}"
PII_RESPONSE_SANITIZATION="{{ 'true' if omniroute_pii_response_sanitization | bool else 'false' }}"
PII_RESPONSE_SANITIZATION_MODE="{{ omniroute_pii_response_sanitization_mode }}"
OMNIROUTE_VSCODE_SANITIZE_CONTEXT="{{ '1' if omniroute_vscode_sanitize_context | bool else '0' }}"

# ── 5. Tool Policies & MCP Server ───────────────────────────────────────────
TOOL_POLICY_MODE="{{ omniroute_tool_policy_mode }}"
OMNIROUTE_PAYLOAD_RULES_PATH="{{ omniroute_payload_rules_path }}"
OMNIROUTE_PAYLOAD_RULES_RELOAD_MS="{{ omniroute_payload_rules_reload_ms }}"
OMNIROUTE_PREFER_CLAUDE_CODE_FOR_UNPREFIXED_CLAUDE_MODELS="{{ 'true' if omniroute_prefer_claude_code_for_unprefixed_claude_models | bool else 'false' }}"

OMNIROUTE_MCP_ENFORCE_SCOPES="{{ 'true' if omniroute_mcp_enforce_scopes | bool else 'false' }}"
{% if omniroute_mcp_scopes %}
OMNIROUTE_MCP_SCOPES="{{ omniroute_mcp_scopes | join(',') }}"
{% endif %}
OMNIROUTE_MCP_COMPRESS_DESCRIPTIONS="{{ '1' if omniroute_mcp_compress_descriptions | bool else '0' }}"
OMNIROUTE_MCP_DESCRIPTION_COMPRESSION="{{ omniroute_mcp_description_compression }}"
OMNIROUTE_MCP_FETCH_TIMEOUT_MS="{{ omniroute_mcp_fetch_timeout_ms }}"
OMNIROUTE_MCP_UPSTREAM_TIMEOUT_MS="{{ omniroute_mcp_upstream_timeout_ms }}"

# ── 6. Outbound Proxy (Egress) ──────────────────────────────────────────────
ENABLE_SOCKS5_PROXY="{{ 'true' if omniroute_enable_socks5_proxy | bool else 'false' }}"
NEXT_PUBLIC_ENABLE_SOCKS5_PROXY="{{ 'true' if omniroute_enable_socks5_proxy | bool else 'false' }}"
{% if omniroute_http_proxy %}
HTTP_PROXY="{{ omniroute_http_proxy }}"
{% endif %}
{% if omniroute_https_proxy %}
HTTPS_PROXY="{{ omniroute_https_proxy }}"
{% endif %}
{% if omniroute_all_proxy %}
ALL_PROXY="{{ omniroute_all_proxy }}"
{% endif %}
NO_PROXY="{{ omniroute_no_proxy }}"

{% if omniroute_proxy_echo_url %}
OMNIROUTE_PROXY_ECHO_URL="{{ omniroute_proxy_echo_url }}"
{% endif %}
OMNIROUTE_PROXY_DISPATCHER_CONNECTIONS="{{ omniroute_proxy_dispatcher_connections }}"
SOCKS_HANDSHAKE_TIMEOUT_MS="{{ omniroute_socks_handshake_timeout_ms }}"
PROXY_FAIL_OPEN="{{ 'true' if omniroute_proxy_fail_open | bool else 'false' }}"
ENABLE_TLS_FINGERPRINT="{{ 'true' if omniroute_enable_tls_fingerprint | bool else 'false' }}"
{% if omniroute_tls_fingerprint_providers %}
TLS_FINGERPRINT_PROVIDERS="{{ omniroute_tls_fingerprint_providers | join(',') }}"
{% endif %}

# ── 7. Heavyweight Admission Gate & Backpressure ────────────────────────────
OMNIROUTE_CHAT_LARGE_BODY_BYTES="{{ omniroute_chat_large_body_bytes }}"
OMNIROUTE_CHAT_HARD_MAX_BODY_BYTES="{{ omniroute_chat_hard_max_body_bytes }}"
OMNIROUTE_CHAT_MAX_HEAVY_IN_FLIGHT="{{ omniroute_chat_max_heavy_in_flight }}"
OMNIROUTE_CHAT_ADMISSION_HEAP_SHED_RATIO="{{ omniroute_chat_admission_heap_shed_ratio }}"
OMNIROUTE_CHAT_ADMISSION_HEALTHY_HEADROOM="{{ omniroute_chat_admission_healthy_headroom }}"
OMNIROUTE_CHAT_HEAVY_MESSAGE_COUNT="{{ omniroute_chat_heavy_message_count }}"
OMNIROUTE_CHAT_HEAVY_TOOL_COUNT="{{ omniroute_chat_heavy_tool_count }}"
OMNIROUTE_CHAT_HEAVY_ESTIMATED_TOKENS="{{ omniroute_chat_heavy_estimated_tokens }}"
OMNIROUTE_CHAT_HARD_MAX_MESSAGES="{{ omniroute_chat_hard_max_messages }}"
OMNIROUTE_CHAT_ADMISSION_QUEUE_MS="{{ omniroute_chat_admission_queue_ms }}"
OMNIROUTE_CHAT_ADMISSION_MAX_QUEUED_BYTES="{{ omniroute_chat_admission_max_queued_bytes }}"
OMNIROUTE_CHAT_VIRTUAL_LANES="{{ omniroute_chat_virtual_lanes }}"
MAX_BODY_SIZE_BYTES="{{ omniroute_max_body_size_bytes }}"
OMNIROUTE_MAX_NONSTREAMING_RESPONSE_BYTES="{{ omniroute_max_nonstreaming_response_bytes }}"
COMBO_CONCURRENCY_PER_MODEL="{{ omniroute_combo_concurrency_per_model }}"
RELAY_IP_PER_MINUTE="{{ omniroute_relay_ip_per_minute }}"

# ── 8. Background Schedulers & Limits ───────────────────────────────────────
CREDENTIAL_HEALTH_CHECK_INTERVAL="{{ omniroute_credential_health_check_interval }}"
CREDENTIAL_HEALTH_CACHE_TTL="{{ omniroute_credential_health_cache_ttl }}"
OMNIROUTE_DISABLE_CREDENTIAL_HEALTH_CHECK="{{ 'true' if omniroute_disable_credential_health_check | bool else 'false' }}"
OMNIROUTE_CONNECTION_RECOVERY_INTERVAL_MS="{{ omniroute_connection_recovery_interval_ms }}"
OMNIROUTE_DISABLE_CONNECTION_RECOVERY="{{ 'true' if omniroute_disable_connection_recovery | bool else 'false' }}"
MODEL_SYNC_INTERVAL_HOURS="{{ omniroute_model_sync_interval_hours }}"
PROVIDER_LIMITS_SYNC_INTERVAL_MINUTES="{{ omniroute_provider_limits_sync_interval_minutes }}"
PROVIDER_LIMITS_SYNC_SPACING_MS="{{ omniroute_provider_limits_sync_spacing_ms }}"
OMNIROUTE_DISABLE_BACKGROUND_SERVICES="{{ 'true' if omniroute_disable_background_services | bool else 'false' }}"

# ── 9. Sidecars & Integrated Ecosystem ──────────────────────────────────────
{% if omniroute_redis_enabled %}
{% if omniroute_redis_url %}
REDIS_URL="{{ omniroute_redis_url }}"
{% else %}
REDIS_URL="redis://:{{ omniroute_effective_redis_password }}@{{ omniroute_redis_bind_host }}:{{ omniroute_redis_port }}"
{% endif %}
REDIS_KEY_PREFIX="{{ omniroute_redis_key_prefix }}"
{% endif %}

{% if omniroute_bifrost_enabled %}
BIFROST_URL="{{ omniroute_bifrost_url }}"
{% endif %}

{% if omniroute_headroom_enabled %}
HEADROOM_URL="{{ omniroute_headroom_url }}"
{% endif %}

{% if omniroute_enable_playwright %}
PLAYWRIGHT_BROWSERS_PATH="{{ omniroute_playwright_browsers_path }}"
{% endif %}
